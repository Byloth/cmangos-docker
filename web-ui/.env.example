# cmangos-docker web UI — env contract (Nuxt runtime config, server-only).
# Copy to .env for local dev (`bun run dev` picks it up automatically).
#
# In the docker stack these values come from the repo's own .env — the compose
# service (Phase 4) wires them through, e.g.:
#   NUXT_CMANGOS_DB_HOST:     ${MANGOS_DBHOST:-mariadb}
#   NUXT_CMANGOS_DB_USER:     ${MANGOS_DBUSER}
#   NUXT_CMANGOS_DB_PASSWORD: ${MANGOS_DBPASS}
#   NUXT_CMANGOS_CORE:        ${WOW_VERSION}
# so the stack keeps a single source of truth (MANGOS_DBHOST / MANGOS_DBUSER /
# MANGOS_DBPASS / WOW_VERSION) and the UI never invents its own.

# Which CMaNGOS core this UI serves: classic | tbc | wotlk.
# Derives the database names (<core>realmd, <core>characters) and the
# `expansion` value stamped on registered accounts (0 / 1 / 2).
NUXT_CMANGOS_CORE=tbc

# MariaDB connection. Use the dedicated least-privilege web user
# (SELECT broadly, INSERT/UPDATE only on realmd.account) — NOT root.
NUXT_CMANGOS_DB_HOST=127.0.0.1
NUXT_CMANGOS_DB_PORT=3306
NUXT_CMANGOS_DB_USER=mangos
NUXT_CMANGOS_DB_PASSWORD=mangos00

# Only for deployments whose databases don't follow the `<core><db>` naming.
# NUXT_CMANGOS_DB_REALMD_NAME=tbcrealmd
# NUXT_CMANGOS_DB_CHARACTERS_NAME=tbccharacters

# Session cookie sealing password — REQUIRED, at least 32 characters.
# Generate: openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# Session lifetime in seconds (default 604800 = 7 days).
# NUXT_SESSION_MAX_AGE=604800

# Send the session cookie with Secure attribute. Only over HTTPS;
# the plain-HTTP docker stack must leave this false.
# NUXT_SESSION_SECURE_COOKIE=false
